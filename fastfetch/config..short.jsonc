{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "",
    "color": {
      "1": "#ff7f7f",
      "2": "#7f3fbf",
      "3": "#7f7fff",  // "#7fbaff",
      "4": "#ff00ff",
      "5": "#ff00ff",
      "6": "#ff00ff",
      "7": "#ff00ff",
      "8": "#ff00ff",
      "9": "#ff00ff"
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 6
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "cache": "regen",
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": true,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": "",
    "color": {
      "keys": "#7f3fbf",
      "title": "#ff7f7f",
      "output": "#7f7fff",
      "separator": "#9999cc"
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      },
      "width": 0
    },
    "fraction": {
      "ndigits": 2
    },
    "noBuffer": false,
    "key": {
      "width": 22,
      "type": "string",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    //
    // https://github.com/fastfetch-cli/fastfetch-wiki/tree/master/Modules
    //
    "break",
    {
      "type": "kernel",
      "outputColor": "#ff7f7f"
    },
    {
      "type": "packages",
      "disabled": [],
      "combined": false
    },
    {
      "type": "localip",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": false,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": ""
    },
    "break",
    {
      "type": "disk",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    "break",
    {
      "key": "Uptime",
      "type": "command",
      "text": "awk '{print $1}' /proc/uptime | my_python_sec_to_regular_time.py"
     },
    {
      "key": "Login",
      "type": "command",
      "text": "fish -c 'my_login_elapsed --second | my_python_sec_to_regular_time.py'"
    },
    {
      "key": "Memory",
      "type": "command",
      "text": "fish -c 'my_memory_mem --short'"
    },
    "break"
  ]
}
