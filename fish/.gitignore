!conf.d/41-vivid.fish
!conf.d/41-zoxide.fish
!conf.d/51-my_function_load_ini.fish
!conf.d/zz-my_fish_frozen_theme.fish

!conf.d/ini/
conf.d/ini/*
!conf.d/ini/.gitkeep
!conf.d/ini/my_*.SAMPLE.ini

