#
# Let’s switch to an approach where we list each file individually—even if it’s a bit of a hassle!
# (Except in special cases.)
#

.git/

###

conf.d/*
!conf.d/.gitkeep
!conf.d/11-my_env.fish
!conf.d/21-add-path.fish
!conf.d/31-abbr-add.fish
!conf.d/41-fzf.fish
!conf.d/41-mise.fish
